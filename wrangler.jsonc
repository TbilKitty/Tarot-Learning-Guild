{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tarot-learning-guild",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"], "html_handling": "auto-trailing-slash", "not_found_handling": "404-page" },
  "vars": {
    "PAYMENTS_ENABLED": "false",
    "FREE_AI_ENABLED": "false",
    "TURNSTILE_SITE_KEY": "",
    "SITE_URL": "https://tarotlearningguide.com",
    "SUPPORT_EMAIL": "rileygreenm@gmail.com",
    "OPENAI_MODEL": "gpt-4.1-mini"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "fifth-card-readings", "database_id": "73a887c8-ccad-4d8e-aa62-91abe3712e0f" }],
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": false }
}

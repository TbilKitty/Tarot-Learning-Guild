{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-fifth-card",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "vars": {
    "PAYMENTS_ENABLED": "false",
    "FREE_AI_ENABLED": "false",
    "TURNSTILE_SITE_KEY": "",
    "SITE_URL": "https://REPLACE-WITH-YOUR-HOSTNAME",
    "SUPPORT_EMAIL": "",
    "OPENAI_MODEL": "gpt-4.1-mini"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "fifth-card-readings", "database_id": "REPLACE-WITH-D1-ID" }],
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": false }
}
